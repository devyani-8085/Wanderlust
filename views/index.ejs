<% layout('layouts/boilerplate') %>
<body>
 <style>
  #filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .filter{
    text-align: center;
    margin-right: 2rem;
    margin-top: 2rem;
    opacity: 0.7;
  }
  .filter:hover{
    opacity: 1;
    cursor: pointer;
  }

  .filter p{
    font-size: 0.8rem;
  }
  .filter-link{
    text-decoration: none;
    color: inherit;
  }
  .filter.active{
    opacity: 1;
    border-bottom: 2px solid black;
  }
  .tax-info{
    display:none;
  }
  .tax-toggle{
    border: 1px solid black;
    border-radius: 1rem;
    height:2.5rem;
    padding: 1rem;
    margin-left: 16rem;
    margin-top: 1rem;
    display: flex;
    align-items: center;
    
    
  }
 </style>

  <div id="filters">
    <a class="filter-link" href="/listings">
      <div class="filter <%= category === 'all' ? 'active' : '' %>">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
      </div>
    </a>

    <a class="filter-link" href="/listings?category=Beach">
      <div class="filter <%= category === 'Beach' ? 'active' : '' %>">
        <div><i class="fa-solid fa-umbrella-beach"></i></div>
        <p>Beach</p>
      </div>
    </a>

    <a class="filter-link" href="/listings?category=Mountains">
      <div class="filter <%= category === 'Mountains' ? 'active' : '' %>">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
      </div>
    </a>

    <a class="filter-link" href="/listings?category=City">
      <div class="filter <%= category === 'City' ? 'active' : '' %>">
        <div><i class="fa-solid fa-city"></i></div>
        <p>City</p>
      </div>
    </a>

    <a class="filter-link" href="/listings?category=Countryside">
      <div class="filter <%= category === 'Countryside' ? 'active' : '' %>">
        <div><i class="fa-solid fa-tractor"></i></div>
        <p>Countryside</p>
      </div>
    </a>

    <a class="filter-link" href="/listings?category=Desert">
      <div class="filter <%= category === 'Desert' ? 'active' : '' %>">
        <div><i class="fa-solid fa-sun"></i></div>
        <p>Desert</p>
      </div>
    </a>

    <a class="filter-link" href="/listings?category=Forest">
      <div class="filter <%= category === 'Forest' ? 'active' : '' %>">
        <div><i class="fa-solid fa-tree"></i></div>
        <p>Forest</p>
      </div>
    </a>

    <a class="filter-link" href="/listings?category=Island">
      <div class="filter <%= category === 'Island' ? 'active' : '' %>">
        <div><i class="fa-solid fa-water"></i></div>
        <p>Island</p>
      </div>
    </a>

    <a class="filter-link" href="/listings?category=Other">
      <div class="filter <%= category === 'Other' ? 'active' : '' %>">
        <div><i class="fa-solid fa-ellipsis"></i></div>
        <p>Other</p>
      </div>
    </a>

   <div class = "tax-toggle">
    <div class="form-check-reverse form-switch">
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
  <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
</div>
</div>

</div>



    <% if (typeof search !== 'undefined' && search) { %>
      <div class="mt-3">
        <p>Search results for "<b><%= search %></b>" &mdash; <%= allListings.length %> found
          <a href="/listings" class="ms-2">Clear search</a>
        </p>
      </div>
    <% } %>

    <% if (allListings.length === 0) { %>
      <div class="mt-4">
        <p>No listings found. Try a different search.</p>
      </div>
    <% } %>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4 mt-3">
    <% for(let listing of allListings){ %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
    <div class="card listing-card" style="width: 20rem;">
  <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_img" style="height:20rem">
  <div class="card-img-overlay"></div>
  <div class="card-body">
    <p class="card-text">
       <b> <%= listing.title %></b></br>
        &#8377;<span class="price-display" data-price="<%= listing.price %>"><%= listing.price.toLocaleString("en-IN")%></span> /night</br>
        <i class = "tax-info">&nbsp; +18% GST</i>
    </p>
  </div>
</div>
</a>
<% } %>
   </div>
</body>
<script>
  let taxToggle = document.getElementById('switchCheckDefault');
  const GST_RATE = 0.18;
  taxToggle.addEventListener("click", () =>{
    let showTax = taxToggle.checked;

    let taxInfoElements = document.getElementsByClassName("tax-info");
    for(info of taxInfoElements){
      info.style.display = showTax ? "inline" : "none";
    }

    let priceElements = document.getElementsByClassName("price-display");
    for(priceEl of priceElements){
      let basePrice = Number(priceEl.dataset.price);
      let displayPrice = showTax ? Math.round(basePrice * (1 + GST_RATE)) : basePrice;
      priceEl.textContent = displayPrice.toLocaleString("en-IN");
    }
  });
  
  </script>